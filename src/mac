# Removes NVM if it is installed.
uninstall_nvm() {
    local nvm_dir="${NVM_DIR:-${XDG_CONFIG_HOME:-$HOME/.nvm}}"
    if [ -d "$nvm_dir" ]; then
        echo "\n💥 Uninstalling Node Version Manager (NVM).\n"
        command -v nvm >/dev/null && nvm unload
        rm -rf "$nvm_dir"
    fi
}

# Interpret commandline arguments and run the appropriate methods.
main() {
    configure_flag=false
    install_flag=false
    uninstall_flag=false
    force_flag=false

    additional_args=()

    # Parse commandline arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--force)
                force_flag=true
                ;;
            configure)
                configure_flag=true
                ;;
            install)
                install_flag=true
                ;;
            uninstall)
                uninstall_flag=true
                ;;
            *)
                additional_args+=("$1")
                ;;
        esac
        shift
    done

    # Configure global variables
    set_global_configurations

    # Run the appropriate command(s)

    if [[ $configure_flag == true ]]; then
        configure_laptop_script

    elif [[ $uninstall_flag == true ]]; then
        uninstall
    
    elif [[ $install_flag == true ]]; then
        install $force_flag
    
    # By default, run the install command.
    else
        install $force_flag
    fi
}

