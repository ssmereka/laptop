    # Indent so that text wraps into a nice paragraph after the prefix.
    local indent="${(l:$((${#prefix}+1)):: :)}"  
    
    # Replaces escape sequences like a new line "\n" with the indentation for wrapping text.
    print "$*" | sed "1s/^/$prefix/;2,\$s/^/$indent/"
    print ""
}

# Display a distinct header message to the user.
# Parameters:
#   emoji: The emoji to display before the header text
#   text: The header text to display (will be uppercased)
log_header() {
    local emoji="$1 "
    local text="${(U)2}"
    local dashes="${(l:${#text}::~:)}"
    print -- "\n $emoji $text"
    print -- "     $dashes\n"
}

