################################################################################
# Global Configurations
################################################################################

# The following variables are user-configurable using the custom_config.sh script.
# These values are set and defined in the "set_global_configurations" method.
laptop_code_directory=""
laptop_config_directory=""
laptop_custom_script_directory=""
laptop_local_repository_directory=""
laptop_log_directory=""
laptop_remote_base_url=""
laptop_remote_ssh_url=""

laptop_secret_item_name_git=""
laptop_secret_field_name_git_email=""
laptop_secret_field_name_git_name=""
laptop_secret_field_name_git_username=""
laptop_secret_item_name_ssh_key=""
laptop_secret_field_name_ssh_key_public=""

laptop_trash_directory=""

# The following variables are generated based on the global configurations in the 
# "set_global_configurations" method.
laptop_custom_config_script=""
laptop_custom_pre_install_script=""
laptop_custom_post_install_script=""
laptop_custom_pre_uninstall_script=""
laptop_custom_post_uninstall_script=""

# The following variables are used to store secrets obtained from 1Password and 
# injected into configurations during the script execution.
git_email=""
git_name=""
git_ssh_public_key=""
git_username=""

# Reapplies environment variables to override any configuration values made previously,
# including those made in the user's custom configuration script.
apply_environment_variables() {
    laptop_code_directory="${LAPTOP_CODE_DIRECTORY:-$laptop_code_directory}"
    laptop_custom_config_script="${LAPTOP_CUSTOM_CONFIG_SCRIPT:-$laptop_custom_config_script}"
    laptop_custom_script_directory="${LAPTOP_CUSTOM_SCRIPT_DIRECTORY:-$laptop_custom_script_directory}"
    laptop_config_directory="${LAPTOP_CONFIG_DIRECTORY:-$laptop_config_directory}"
    laptop_local_repository_directory="${LAPTOP_LOCAL_REPOSITORY_DIRECTORY:-$laptop_local_repository_directory}"
    laptop_log_directory="${LAPTOP_LOG_DIRECTORY:-$laptop_log_directory}"
    laptop_remote_base_url="${LAPTOP_REMOTE_BASE_URL:-$laptop_remote_base_url}"
    laptop_remote_ssh_url="${LAPTOP_REMOTE_SSH_URL:-$laptop_remote_ssh_url}"
    laptop_secret_item_name_git="${LAPTOP_SECRET_ITEM_NAME_GIT:-$laptop_secret_item_name_git}"
    laptop_secret_field_name_git_email="${LAPTOP_SECRET_FIELD_NAME_GIT_EMAIL:-$laptop_secret_field_name_git_email}"
    laptop_secret_field_name_git_name="${LAPTOP_SECRET_FIELD_NAME_GIT_NAME:-$laptop_secret_field_name_git_name}"
    laptop_secret_field_name_git_username="${LAPTOP_SECRET_FIELD_NAME_GIT_USERNAME:-$laptop_secret_field_name_git_username}"
    laptop_secret_item_name_ssh_key="${LAPTOP_SECRET_ITEM_NAME_SSH_KEY:-$laptop_secret_item_name_ssh_key}"
    laptop_secret_field_name_ssh_key_public="${LAPTOP_SECRET_FIELD_NAME_SSH_KEY_PUBLIC:-$laptop_secret_field_name_ssh_key_public}"
    laptop_trash_directory="${LAPTOP_TRASH_DIRECTORY:-$laptop_trash_directory}"
}

# Sets the value for each global configuration variable. Variables are given a 
# default value which can be overridden by an environment variable. These are
# then passed into the user's custom configuration script where they can adjust
# variables as needed. Environment variables are again used to override any
# user changes as they take precedence over all other configuration sources.
# After global configurations are set, derived paths variables are set.
set_global_configurations() {
    # Directory where all coding projects will be cloned and stored.
    laptop_code_directory="${LAPTOP_CODE_DIRECTORY:-$HOME/code}"

    # Path to the user's optional custom configuration script. This file is executed before
    # commands are executed, allowing users to set or override variables and methods.
    laptop_custom_config_script="${LAPTOP_CUSTOM_CONFIG_SCRIPT:-$HOME/.laptop/custom_config.sh}"

    # Directory where a user's custom scripts are stored. Laptop will run and source 
    # files from this directory, make sure proper permissions are set. Laptop will always
    # require confirmation or a force flag before overwriting files in this directory.
    laptop_custom_script_directory="${LAPTOP_CUSTOM_SCRIPT_DIRECTORY:-$HOME/.laptop}"

    # Directory where local Laptop configurations are stored. Laptop will create files
    # in this directory and link them to appropriate locations. Users can modify these
    # files as needed. Laptop will always require confirmation or a force flag before
    # overwriting files in this directory.
    laptop_config_directory="${LAPTOP_CONFIG_DIRECTORY:-$HOME/.config/laptop}"

    # Directory where a local copy of the Laptop repository will be cloned and stored.
    laptop_local_repository_directory="${LAPTOP_LOCAL_REPOSITORY_DIRECTORY:-$laptop_code_directory/ssmereka/laptop}"

    # Directory where log files are stored for Laptop.
    laptop_log_directory="${LAPTOP_LOG_DIRECTORY:-$HOME/Library/Logs/Laptop}"

    # A URL to the most recent Laptop code repository stored in GitHub. This should point
    # to the root directory so you can append file paths to navigate to files and folders
    # in the repository.
    laptop_remote_base_url="${LAPTOP_REMOTE_BASE_URL:-https://raw.githubusercontent.com/ssmereka/laptop/refs/heads/main}"

    # The URL used to clone the remote Laptop repository via SSH.
    laptop_remote_ssh_url="${LAPTOP_REMOTE_SSH_URL:-git@github.com:ssmereka/laptop.git}"

    # The name of the 1Password "item" where the Git configurations exist, including email, name, and
    # username.
    laptop_secret_item_name_git="${LAPTOP_SECRET_ITEM_NAME_GIT:-GitHub}"

    # Name of the 1Password "field" in the item "laptop_secret_item_name_git" that contains the email address that
    # should be used by the Git client.
    laptop_secret_field_name_git_email="${LAPTOP_SECRET_FIELD_NAME_GIT_EMAIL:-GitHub Email}"

    # Name of the 1Password "field" in the item "laptop_secret_item_name_git" that contains the name that
    # should be used by the Git client.
    laptop_secret_field_name_git_name="${LAPTOP_SECRET_FIELD_NAME_GIT_NAME:-Name}"
    
    # Name of the 1Password "field" in the item "laptop_secret_item_name_git" that contains the git username that
    # should be used by the Git client.
    laptop_secret_field_name_git_username="${LAPTOP_SECRET_FIELD_NAME_GIT_USERNAME:-GitHub Username}"

    # The name of the 1Password "item" where the Git SSH Key configurations exist. This key should be
    # added to your remote Git repository, eg. GitHub.
    laptop_secret_item_name_ssh_key="${LAPTOP_SECRET_ITEM_NAME_SSH_KEY:-GitHub SSH Key}"

    # Name of the 1Password "field" in the item "laptop_secret_item_name_ssh_key" that contains the public ssh key
    # used by your remote Git repository, eg. GitHub.
    laptop_secret_field_name_ssh_key_public="${LAPTOP_SECRET_FIELD_NAME_SSH_KEY_PUBLIC:-public key}"

    # Directory where Laptop files or configurations are moved when they should be deleted.
    # Enables user to recover files if needed and they will be automatically removed when the
    # computer is restarted.
    laptop_trash_directory="${LAPTOP_TRASH_DIRECTORY:-/tmp/Laptop}"


    # Run the user's custom configuration script to override any variables.
    run_custom_script "$laptop_custom_config_script" "custom configuration script"

    # Validate that all required variables are set to non-empty string values.
    require_non_empty_string_variable "laptop_code_directory"
    require_non_empty_string_variable "laptop_custom_config_script"
    require_non_empty_string_variable "laptop_custom_script_directory"
    require_non_empty_string_variable "laptop_config_directory"
    require_non_empty_string_variable "laptop_local_repository_directory"
    require_non_empty_string_variable "laptop_log_directory"
    require_non_empty_string_variable "laptop_remote_base_url"
    require_non_empty_string_variable "laptop_remote_ssh_url"
    require_non_empty_string_variable "laptop_secret_item_name_git"
    require_non_empty_string_variable "laptop_secret_field_name_git_email"
    require_non_empty_string_variable "laptop_secret_field_name_git_name"
    require_non_empty_string_variable "laptop_secret_field_name_git_username"
    require_non_empty_string_variable "laptop_secret_item_name_ssh_key"
    require_non_empty_string_variable "laptop_secret_field_name_ssh_key_public"
    require_non_empty_string_variable "laptop_trash_directory"

    # Environment variables take precedence over configuration files and default values.
    # Reapply the environment variables after loading the user's script.
    apply_environment_variables

    # The following paths can be derived from the global configuration variables.

    # Path to the user's optional custom pre install script. This file is executed before
    # the install command.
    laptop_custom_pre_install_script="$laptop_custom_script_directory/custom_pre_install.sh"

    # Path to the user's optional custom post install script. This file is executed after
    # the install command.
    laptop_custom_post_install_script="$laptop_custom_script_directory/custom_post_install.sh"

    # Path to the user's optional custom pre uninstall script. This file is executed before
    # the uninstall command.
    laptop_custom_pre_uninstall_script="$laptop_custom_script_directory/custom_pre_uninstall.sh"

    # Path to the user's optional custom post uninstall script. This file is executed after
    # the uninstall command.
    laptop_custom_post_uninstall_script="$laptop_custom_script_directory/custom_post_uninstall.sh"
}


