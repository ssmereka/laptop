# Interpret commandline arguments and run the appropriate commands.
main() {
    local configure_flag=false
    local install_flag=false
    local uninstall_flag=false
    local force_flag=false

    local additional_args=()

    # Parse commandline arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--force)
                force_flag=true
                ;;
            configure)
                configure_flag=true
                ;;
            install)
                install_flag=true
                ;;
            uninstall)
                uninstall_flag=true
                ;;
            *)
                additional_args+=("$1")
                ;;
        esac
        shift
    done

    # Configure global variables
    set_global_configurations
    
    # Configure logging.
    configure_logs

    # Run the appropriate command(s)

    if [[ $configure_flag == true ]]; then
        configure_laptop_script

    elif [[ $uninstall_flag == true ]]; then
        uninstall $force_flag
    
    elif [[ $install_flag == true ]]; then
        install $force_flag
    
    # By default, run the install command.
    else
        install $force_flag
    fi
}

