# Create a soft symbolic link from the source file to the destination file, overwriting the link
# if it already exists.
# Parameters:
#   source_path: The path to the source file to copy or URL of the file to download.
#   destination_path: The destination path where the file will be copied or downloaded.
link_file() {
    local source_path="$1"
    local destination_path="$2"

    # The "ln" command will fail if the directories in the destination 
    # path do not exist. Create all the destination directories, if they do not exist.
    mkdir -p "$(dirname "$destination_path")"

    log "Creating a new symbolic link from \"$source_path\" to \"$destination_path\""
    ln -sf "$source_path" "$destination_path"
}

