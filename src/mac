# Run a custom script located at the given path, if it exists, and ask for confirmation
# before running it, unless confirmation is disabled.
# Parameters:
#   custom_script_path:  The path to the custom script to run.
#   custom_script_name:  A friendly name for the script, used in log messages. Defaults to
#                        "custom script" if not provided.
#   require_confirmation: A boolean indicating whether to prompt the user for confirmation
#                         before running the script. Defaults to true.
run_custom_script() {
    local custom_script_path="$1"
    local custom_script_name="${2:-custom script}"
    local require_confirmation="${3:-true}"

    if [ -f "$custom_script_path" ]; then
        log_header "🏃" "$custom_script_name"

        # Confirm user wants to run the custom script, unless confirmation is disabled
        if [[ $require_confirmation == true ]]; then
            log_attention "Found $custom_script_name at path \"$custom_script_path\"."
            if ! log_prompt "Would you like to run this file? [Y/n]"; then
                log "User declined to run the $custom_script_name."
                return
            fi
        fi

        log "Running the $custom_script_name at path \"$custom_script_path\""

        # Execute the script in the current shell environment.
        # This is risky, so make sure to only run scripts from trusted sources.
        set -a
        source "$custom_script_path"
        set +a
    fi 
}

# Move the given file or directory to the trash directory for deletion on restart.
# Parameters:
#   path_to_trash: The path to the file or directory to move to the trash.
trash() {
    local path_to_trash="$1"

    # Validate argument was provided. Script should terminate if a deletion
    # operation was unsuccessful to prevent unknown states.
    if [[ -z "$path_to_trash" ]]; then
        log_error "trash() requires a path argument."
        exit 1
    fi

    # Remove trailing slashes for consistent basename behavior
    path_to_trash="${path_to_trash%/}"

    # Create a timestamp using nanoseconds to avoid file name collisions.
    local timestamp="$(date +%s.%N)"
    local new_path="$laptop_trash_directory/$(basename "$path_to_trash").bkp.$timestamp"

    # Check for files, directories, and symlinks (including broken ones)
    if [[ -e "$path_to_trash" || -L "$path_to_trash" ]]; then
        mkdir -p "$laptop_trash_directory"
        log "Moving \"$path_to_trash\" to \"$new_path\". It will be deleted when your computer restarts."
        mv "$path_to_trash" "$new_path"
    else
        log "Nothing exists at path \"$path_to_trash\"."
    fi
}

# Remove a symbolic link from the destination, if it exists. This reverses
# the operation of "link_file" method.
# Parameters:
#   destination_path: The symbolic link to be removed.
unlink_file() {
    local destination_path="$1"

    # Validate argument was provided
    if [[ -z "$destination_path" ]]; then
        log_error "unlink_file() requires a valid \"destination_path\" argument."
        exit 1
    fi

    # Remove trailing slashes for consistent behavior
    destination_path="${destination_path%/}"

    # Check if path exists and is a symbolic link
    if [[ -L "$destination_path" ]]; then
        log "Removing the symbolic link from \"$destination_path\""
        rm "$destination_path"
    else
        log "No symbolic link exists at \"$destination_path\"."
    fi
}

# Update the local Laptop repository, pulling down all new changes. If there are local changes the
# user will be prompted to stash those changes before pulling. If the user declines the update will
# be cancelled, but the script will continue.
update_laptop_repository() {
    pushd "$laptop_local_repository_directory" > /dev/null

    log_header "🔁" "Updating Laptop Repository"

    # If there are changes in the local repository, ask the user if 
    # they want to stash and pull the latest changes.
    if [[ `git status --porcelain` || $(git rev-parse --abbrev-ref HEAD) != "main" ]]; then

        # Inform the user that there are unsaved changes in the Laptop git repository.
        local attention_text="Cannot pull the latest changes from the remote Laptop repository, "
        attention_text+="\nbecause there are local changes or you are not on the \"main\" branch."
        attention_text+="\n\n"
        attention_text+="Y:  Proceed without the latest changes from the remote Laptop repository."
        attention_text+="\n\n"
        attention_text+="    OR"
        attention_text+="\n\n"
        attention_text+="N:  Stash the local changes, then pull the latest from the remote Laptop"
        attention_text+="\n    repository. Reapply the local changes with \"git stash pop\" command."
        
        # Ask how they want to proceed.
        local attention_prompt="Continue without pulling the latest changes? [Y/n]"
        
        log_attention "$attention_text"
        if log_prompt "$attention_prompt"; then
            # User chose to continue without pulling the latest changes.
            log "Skipped pulling the latest changes from the remote Laptop repository."
            
            return
        else
            # User chose to stash the local changes and pull latest.
            attention_text="Stashing local changes. After Laptop completes you can restore those changes with:\n"
            attention_text+=$(log_command "cd '$laptop_local_repository_directory' && git stash pop")
            log_attention "$attention_text"

            git stash
        fi
    fi

    log "Checking out the \"main\" branch and pulling changes."
    git fetch
    git checkout main
    git pull origin main

    popd > /dev/null
}


