# Create a custom configuration file for Laptop that the user can modify.
configure_laptop_script() {
    log_header "🔧" "Setup Custom Laptop Configuration"
    
    # By default, use the remote Laptop repository source files when configuring the computer.
    local laptop_examples_location="$laptop_remote_base_url/examples"

    if is_laptop_installed; then
        # When Laptop repository is available locally, use the local files for configuration
        laptop_examples_location="$laptop_local_repository_directory/examples"
    fi

    copy_file "$laptop_examples_location/custom_config.sh" "$laptop_custom_config_script"

    local attention_prompt="Open the custom configuration file now? [Y/n]"
    local attention_text="Customize Laptop by modifying the file \"$laptop_custom_config_script\"."
    
    log_attention "$attention_text"
    
    if log_prompt "$attention_prompt"; then
        # Open the custom configuration file for editing in VS code if installed, otherwise TextEdit.
        if [ -d "/Applications/Visual Studio Code.app" ]; then
            code "$laptop_custom_config_script"
        else
            open -e "$laptop_custom_config_script"
        fi
    fi
}

# Laptop Install will install and configure the computer for development. The
# command is idempotent so you can run it as many times as you like. To reset
# all local configurations and re-apply the default Laptop configurations, use
# the --force flag.
# Parameters:
#   force_flag: A boolean indicating whether to force reinstallation of all configurations.
install() {
    local force_flag="$1"

    log_header "💻" "Configuring your Laptop"

    # Run the user's custom pre-install script.
    run_custom_script "$laptop_custom_pre_install_script" "pre-install script"

    # By default, use the remote Laptop repository source files when configuring the computer.
    local laptop_src_location="$laptop_remote_base_url/src"
    
    if is_laptop_installed; then
        # Prompt the user for access to 1Password before long running tasks.
        get_secrets

        # Use the local files for configuration
        laptop_src_location="$laptop_local_repository_directory/src"

        # Update the script's source code before continuing
        update_laptop_repository
    fi

    if [[ $force_flag == true ]]; then
        # Delete all local configurations so that they will be recreated with the default values.
        # Effectively removing any local changes made after the script was initially run.
        remove_laptop_configs false
    fi

    install_apple_developer_tools
    install_or_update_homebrew
    install_apps
    configure_ssh "$laptop_src_location"
    configure_git "$laptop_src_location"
    configure_zsh "$laptop_src_location"

    configure_gh

    clone_laptop_repository

    # Run the user's custom post-install script.
    run_custom_script "$laptop_custom_post_install_script" "post-install script"

    clear_secrets

    log_header "🎉" "Installation is complete"
    log_attention "Close this terminal session and start a new one to use the updated configurations.\n"
}

# Laptop Uninstall command will reverse the "Install" command. Removing anything
# installed or configured by the Laptop script. The command is idempotent so you
# can run it as many times as you like.
# Parameters:
#   force_flag: A boolean indicating whether to skip confirmation prompts.
uninstall() {
    local force_flag=${1:-false}
    
    # Set to the opposite of the "force_flag", because when force is true we do not require confirmation.
    local require_confirmation=$([[ $force_flag == true ]] && echo false || echo true)

    log_header "💻" "Unconfiguring your Laptop"

    # Run the user's custom pre-uninstall script.
    run_custom_script "$laptop_custom_pre_uninstall_script" "pre-uninstall script"

    log_header "🧨" "Uninstalling Applications"

    uninstall_brew_package "1password-cli" "$require_confirmation"
    uninstall_brew_package "atuin" false
    uninstall_brew_package "awscli" false
    uninstall_brew_package "curl" "$require_confirmation"
    uninstall_brew_package "coreutils" "$require_confirmation"
    uninstall_brew_package "gawk" "$require_confirmation"
    uninstall_brew_package "gh" false
    uninstall_brew_package "gmp" "$require_confirmation"
    uninstall_brew_package "gnupg" "$require_confirmation"
    uninstall_brew_package "libyaml" "$require_confirmation"
    uninstall_brew_package "mise" false
    uninstall_brew_package "openssl@3" "$require_confirmation"
    uninstall_brew_package "postgresql" false
    uninstall_brew_package "rustup-init" false
    uninstall_brew_package "visual-studio-code" "$require_confirmation"

    uninstall_nvm

    log_header "🧨" "Removing Application Data"

    # Move the Laptop configuration directory to the $trash_directory for deletion on restart.
    remove_laptop_configs "$require_confirmation"

    # Remove the mise data directory that contains the installed tools.
    rm -rf "$HOME/.local/share/mise"

    # Remove the 1Password SSH agent socket symbolic link.
    unlink_file "$HOME/.1password/agent.sock"

    # Run the user's custom post-uninstall script.
    run_custom_script "$laptop_custom_post_uninstall_script" "post-uninstall script"

    log_header "🎉" "Uninstall is complete"

    local attention_text="Close this terminal session and start a new one to use the updated configurations.\n"
    attention_text+="\nIf you want to remove the Laptop local code repository, run the following command:\n"
    attention_text+=$(log_command "rm -rf \"$laptop_local_repository_directory\"")
    
    log_attention "$attention_text"
}

# Uninstall a Homebrew package by name. Prompts the user for confirmation
# before uninstalling, unless confirmation is disabled.
# Parameters:
#   package_name: The name of the Homebrew package to uninstall.
#   require_confirmation: A boolean indicating whether to prompt the user for confirmation
#                         before uninstalling the package. Defaults to true.
uninstall_brew_package() {
    local package_name="$1"
    local require_confirmation=${2:-true}

    # Check if the package is installed
    if brew list "$package_name" &>/dev/null; then
        
        # Check if confirmation is required
        if [[ $require_confirmation == true ]]; then
            log_attention "Uninstall brew package \"$package_name\"?"

            if ! log_prompt "Uninstall? [Y/n]"; then
                log "User declined to uninstall brew package \"$package_name\"."
                return 0
            fi
        fi
        
        log "Uninstalling brew package $package_name."
        brew uninstall "$package_name"
    fi
}

# Removes Node Version Manager (NVM), if it is installed.
uninstall_nvm() {
    local nvm_dir="${NVM_DIR:-${XDG_CONFIG_HOME:-$HOME/.nvm}}"

    if [ -d "$nvm_dir" ]; then
        log "Uninstalling Node Version Manager (NVM)."
        command -v nvm >/dev/null && nvm unload
        rm -rf "$nvm_dir"
    fi
}


