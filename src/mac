    log "  secret_field_name_git_name:          \"$secret_field_name_git_name\""
    log "  secret_field_name_git_username:      \"$secret_field_name_git_username\""
    log "  secret_item_name_ssh_key:            \"$secret_item_name_ssh_key\""
    log "  secret_field_name_ssh_key_public:    \"$secret_field_name_ssh_key_public\""
    
    log "\nCustom Script Paths:"
    log "  laptop_custom_config_script:         \"$laptop_custom_config_script\""
    log "  laptop_custom_pre_install_script:    \"$laptop_custom_pre_install_script\""
    log "  laptop_custom_post_install_script:   \"$laptop_custom_post_install_script\""
    log "  laptop_custom_pre_uninstall_script:  \"$laptop_custom_pre_uninstall_script\""
    log "  laptop_custom_post_uninstall_script: \"$laptop_custom_post_uninstall_script\"\n"
}

log_attention() {
    print -- " 🟠 [$(date '+%T')] ATTENTION: "$*"\n"
}

log_attention_with_prompt() {
    local prompt="${1:-Ready to continue? [Y/n]}"
    local text="${@:2}"

    log_attention "$text"
    read "response? 🤨 $prompt "
    print -- ""

    if [[ -z $response || $response =~ ^[Yy] ]]; then
        # User confirmed with an empty response (ie. pressed enter) or the letter "Y".
        return 0
    else
        # User declined by entering any value (length > zero) that is not "Y".
        return 1
    fi
}

log_command() {
    print -- "\n\t 🖥️   TERMINAL COMMAND: "$*""
    print -- "\t    ~~~~~~~~~~~~~~~~~\n"
}

# Display a distinct header message to the user.
# Parameters:
#   emoji: The emoji to display before the header text
#   text: The header text to display (will be uppercased)
log_header() {
    local emoji="$1 "
    local text="${(U)2}"
    local dashes="${(l:${#text}::~:)}"
    print -- "\n $emoji $text"
    print -- "     $dashes\n"
}

log_secrets() {
    log_header "🔐" "Current Secrets in Memory"

    log "  git_email:          \"$git_email\""
    log "  git_name:           \"$git_name\""
    log "  git_ssh_public_key: \"$git_ssh_public_key\""
    log "  git_username:       \"$git_username\"\n"
}

# Validate that a named variable exists and has a non-empty string value.
require_non_empty_string_variable() {
    local var_name="$1"
    local var_value="${(P)var_name}"

    if [[ -z "${var_value//[[:space:]]/}" ]]; then
        exit_with_error "The variable \"$var_name\" must be set to a valid value for Laptop to continue."
    fi
}

# Run a custom script located at the given path, if it exists. Verifies the script is 
# executable and asks for confirmation before running it, unless confirmation is disabled.
# Parameters:
#   custom_script_path:  The path to the custom script to run.
#   custom_script_name:  A friendly name for the script, used in log messages. Defaults to
#                        "custom script" if not provided.
#   require_confirmation: A boolean indicating whether to prompt the user for confirmation
#                         before running the script. Defaults to true.
run_custom_script() {
    custom_script_path="$1"
    custom_script_name="${2:-custom script}"
    require_confirmation=${3:-true}

    if [ -f "$custom_script_path" ]; then
        
        
        # Verify custom script is executable.
        if [ ! -x "$custom_script_path" ]; then
            log_header "💡" "Found $custom_script_name at path \"$custom_script_path\" with invalid permissions."
            exit_with_error "Custom script at path \"$custom_script_path\" is not executable. " \
                            "Please update the script's permissions.\n\n" \
                            "\tTry: chmod +x $custom_script_path"
        fi

        # Confirm user wants to run the custom script, unless confirmation is disabled
        if [[ $require_confirmation == true ]]; then
            log_header "💡" "Found $custom_script_name at path \"$custom_script_path\"."
            log "🤔 Would you like to run it?\n\n" \
                "> Press any key to run this file...\n"
            read -n 1
        fi

        log_header "🏃" "$custom_script_name"
        log "Running the $custom_script_name at path \"$custom_script_path\""


        # Execute the script in the current shell environment.
        set -a
        source "$custom_script_path"
        set +a
    fi 
}

# Update the local Laptop repository, pulling down all new changes. If there are local changes the
# user will be prompted to stash those changes before pulling. If the user declines the update will
# be cancelled, but the script will continue.
update_laptop_repository() {
    pushd $laptop_repo_directory > /dev/null

    log_header "🔁" "Updating Laptop Repository"

    # If there are changes in the local repository, ask the user if 
    # they want to stash and pull the latest changes.
    if [[ `git status --porcelain` || $(git rev-parse --abbrev-ref HEAD) != "main" ]]; then

        # Prompt to inform the user that there are unsaved changes in the Laptop git repository.
        local attention_prompt="Continue without pulling the latest changes? [Y/n]"
        local attention_text="Cannot pull the latest changes from the remote Laptop repository, "
        attention_text+="\n\tbecause there are local changes or you are not on the "main" branch."
        attention_text+="\n\n"
        attention_text+="\tY:  Proceed without the latest changes from the remote Laptop repository."
        attention_text+="\n\n"
        attention_text+="\t    OR"
        attention_text+="\n\n"
        attention_text+="\tN:  Stash the local changes, then pull the latest from the remote Laptop"
        attention_text+="\n\t    repository. Reapply the local changes with \"git stash pop\" command."

        if log_attention_with_prompt "$attention_prompt" "$attention_text"; then
            # User chose to continue without pulling the latest changes.
            log "Skipped pulling the latest changes from the remote Laptop repository."
            return
        else
            # User chose to stash the local changes and pull latest.
            log_attention "Stashing local changes. After Laptop completes you can restore those changes with:"
            log_command "cd '$laptop_repo_directory' && git stash pop"
            git stash
        fi
    fi

    log "\nChecking out the \"main\" branch and pulling changes.\n"
    git fetch
    git checkout main
    git pull origin main

    popd > /dev/null
}


# Command Methods

install() {
    force_flag="$1"

    log_header "💻" "Configuring your Laptop"

    # Run the user's custom pre-install script.
    run_custom_script "$laptop_custom_pre_install_script" "pre-install script"

    # By default, use the remote Laptop repository source files when configuring the computer.
    local laptop_src_location="$remote_laptop_base_url/src"
    
    if is_laptop_installed; then
        # Prompt the user for access to 1Password before long running tasks.
        get_secrets

        # Use the local files for configuration
        laptop_src_location="$laptop_repo_directory/src"

        # Update the script's source code before continuing
        update_laptop_repository
    fi

    if [[ $force_flag == true ]]; then
        # Delete all local configurations so that they will be recreated with the default values.
        # Effectively removing any local changes made after the script was initially run.
        clear_laptop_configs
    fi

    install_apple_developer_tools
    install_or_update_homebrew
    install_apps
    configure_ssh "$laptop_src_location"
    configure_git "$laptop_src_location"
    configure_zsh "$laptop_src_location"

    configure_gh

    clone_laptop_repository

    # Run the user's custom post-install script.
    run_custom_script "$laptop_custom_post_install_script" "post-install script"

    clear_secrets

    log_header "🎉" "Installation is complete"
    log_attention "Close this terminal session and start a new one to use the updated configurations.\n"
}

