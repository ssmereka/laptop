# Clears any variables that may be storing secrets pulled from 1Password.
clear_secrets() {
    log_header "🔒" "Clear Secrets from Memory"
    log "Erasing secret variables \"git_email\", \"git_name\", \"git_ssh_public_key\", and \"git_username\" from memory."

    unset git_email
    unset git_name
    unset git_ssh_public_key
    unset git_username
}

# Clone the remote Laptop repository locally using SSH, if it doesn't already exist.
clone_laptop_repository() {
    if [[ ! -d "$laptop_local_repository_directory" ]]; then
        mkdir -p "$laptop_local_repository_directory"
        git clone "$laptop_remote_ssh_url" "$laptop_local_repository_directory"

        if [[ ! -f "$laptop_local_repository_directory/src/mac" ]]; then
            local error_text="Failed to clone Laptop from \"$laptop_remote_ssh_url\" to \"$laptop_local_repository_directory\".\n"
            error_text+=$(log_command "git clone \"$laptop_remote_ssh_url\" \"$laptop_local_repository_directory\"")
            log_error "$error_text"
            exit 1
        fi
    fi
}

# Configure the 1Password GitHub CLI plugin so that it uses the Personal Access Token
# from 1Password for authentication.
configure_gh() {
    log_header "😸" "Configuring GitHub CLI"

    local github_plugin_config_path="$HOME/.config/op/plugins/gh.json"

    if [[ ! -f "$github_plugin_config_path" ]]; then
        local attention_text="Initializing the 1Password GitHub CLI Plugin. Follow these steps:"
        attention_text+="\n"
        attention_text+="\n\t1. Make sure you have a valid GitHub Personal Access Token stored in 1Password in a field named \"token\"."
        attention_text+="\n\t2. When asked to locate your token, navigate to the name of the 1Password item where your Personal Access Token was stored."
        attention_text+="\n\t3. When asked to configure when the chosen credentials will be used, select \"Use as global default on my system.\""
        attention_text+="\n"
        attention_text+="\n\tMore info can be found here:"
        attention_text+="\n\thttps://developer.1password.com/docs/cli/shell-plugins/github/#step-2-configure-your-default-credentials"

        log_attention "$attention_text"
        
        if log_prompt_continue; then
            log_attention "Requesting Unlock of 1Password to configure the GitHub plugin."
            op signin
            
            log "Initializing the 1Password GitHub CLI plugin."
            op plugin init gh
        else
            log_error "The 1Password GitHub CLI plugin configuration was cancelled by the user."
            exit 1
        fi
    fi

    log "Verifying 1Password GitHub plugin"
    op plugin inspect gh

    local attention_text="Check if the verification was successful.\n"
    attention_text+="\n\tIf you encounter an issue try deleting the configuration at \"$github_plugin_config_path\", then try again."

    log_attention "$attention_text"

    if ! log_prompt_continue; then
        log_error "The 1Password GitHub CLI plugin configuration was cancelled by the user."
        exit 1
    fi
}

# Create a Git configuration file with the user's GitHub information from 1Password.
# Parameters:
#   laptop_src_location: A local directory path or a remote URL for the Laptop source code
#                        directory. Defaults to the "$laptop_local_repository_directory/src" variable.
configure_git() {
    local laptop_src_location=${1:-"$laptop_local_repository_directory/src"}

    log_header "🔧" "Configuring Git"

    # Check if secrets are available to avoid unnecessary prompts to the user.
    if [[ -z "$git_email" || -z "$git_name" || -z "$git_username" || -z "$git_ssh_public_key" ]]; then
        get_secrets
    fi

    # Create a local Git allowed signers file from the Laptop template.
    local local_git_allowed_signers="$laptop_config_directory/.git-allowed-signers"
    copy_file "$laptop_src_location/.git-allowed-signers" "$local_git_allowed_signers"
    chmod 600 "$local_git_allowed_signers"

    # Create a local Git configuration file from the Laptop template.
    local local_gitconfig="$laptop_config_directory/.gitconfig"
    copy_file "$laptop_src_location/.gitconfig" "$local_gitconfig"

    # Replace the allowed signers template variables using the information from 1Password.
    sed -i '' "s|GIT_NAME|${git_name}|" "$local_git_allowed_signers"
    sed -i '' "s|GIT_SSH_PUBLIC_KEY|${git_ssh_public_key}|" "$local_git_allowed_signers"

    # Replace the gitconfig template variables using the information from 1Password.
    sed -i '' "s|GIT_EMAIL|${git_email}|" "$local_gitconfig"
    sed -i '' "s|GIT_NAME|${git_name}|" "$local_gitconfig"
    sed -i '' "s|GIT_SSH_PUBLIC_KEY|${git_ssh_public_key}|" "$local_gitconfig"
    sed -i '' "s|GIT_USERNAME|${git_username}|" "$local_gitconfig"

    # Replace the gitconfig template allowed signers path variable with the location of the newly
    # configured allowed signers file.
    sed -i '' "s|PATH_TO_GIT_ALLOWED_SIGNERS|${local_git_allowed_signers}|" "$local_gitconfig"

    # Symbolically link the .gitconfig to the proper location.
    link_file "$local_gitconfig" "$HOME/.gitconfig"
}

# Configure the log directory for Laptop. This is where all log files will be stored.
# Parameters:
#   log_directory: A directory path where logs will be stored. 
#                  Defaults to the "$laptop_log_directory" variable.
configure_logs() {
    local log_directory=${1:-$laptop_log_directory}

    log_header "✍️" "Configuring Logs"

    # Create the log directory if it doesn't already exist.
    mkdir -p "$log_directory"

    # Set permissions to:
    # - Allow the owner to read, write, and execute log files.
    # - Allow the group to read and write log files.
    # - Allow others to read log files, but not write or execute them.
    chmod 764 "$log_directory"

    log "Laptop log directory is set to \"$log_directory\"."
}

# Configure Mise to use the Laptop configuration files.
# Parameters:
#   laptop_src_location: A local directory path or a remote URL for the Laptop source code
#                        directory. Defaults to the "$laptop_local_repository_directory/src" variable.
configure_mise() {
    local laptop_src_location=${1:-"$laptop_local_repository_directory/src"}

    log_header "🔧" "Configuring Mise"

    # Create a local Mise configuration file.
    copy_file "$laptop_src_location/.mise_config.toml" "$laptop_config_directory/.mise_config.toml"
    link_file "$laptop_config_directory/.mise_config.toml" "$HOME/.config/mise/config.toml"

    # Create a local Default Gems file.
    copy_file "$laptop_src_location/.default-gems" "$laptop_config_directory/.default-gems"
    link_file "$laptop_config_directory/.default-gems" "$HOME/.default-gems"

    # Trust the local configuration file to prevent prompts in the automated install.
    mise trust "$HOME/.config/mise/config.toml" || true
}

# Configure SSH to use the SSH keys in 1Password.
# Parameters:
#   laptop_src_location: A local directory path or a remote URL for the Laptop source code
#                        directory. Defaults to the "$laptop_local_repository_directory/src" variable.
configure_ssh() {
    local laptop_src_location=${1:-"$laptop_local_repository_directory/src"}

    log_header "🔧" "Configuring SSH"

    # Create the default SSH directory (if it doesn't already exist)
    # and configure SSH to lookup SSH keys in 1Password
    mkdir -p "$HOME/.ssh/"
    chmod 700 "$HOME/.ssh"

    # Create a local .ssh_config configuration file from the Laptop template.
    local_ssh_config_path="$laptop_config_directory/.ssh_config"
    copy_file "$laptop_src_location/.ssh_config" "$local_ssh_config_path"
    
    # Grant the owner read/write permissions to the local SSH configuration file.
    # This is the required permission level for SSH to use the file.
    chmod 600 "$local_ssh_config_path"

    # Symbolicially link the local ssh config to the default location.
    link_file "$local_ssh_config_path" "$HOME/.ssh/config"
    
    # Create a local 1Password agent configuration file from the Laptop template.
    local_onepassword_agent_path="$laptop_config_directory/agent.toml"
    copy_file "$laptop_src_location/agent.toml" "$local_onepassword_agent_path"
    
    # Symbolicially link the local 1Password agent configuration to the default location.
    mkdir -p "$HOME/.config/1Password/ssh/"
    link_file "$local_onepassword_agent_path" "$HOME/.config/1Password/ssh/agent.toml"

    # Follow 1Password's recommendation to create a shortcut to the 1Password SSH Agent 
    # Integration, ie "~/.1password/agent.sock".
    mkdir -p "$HOME/.1password"
    link_file "$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock" "$HOME/.1password/agent.sock"
}

# Configure ZSH to use the Laptop configuration files.
# Parameters:
#   laptop_src_location: A local directory path or a remote URL for the Laptop source code
#                        directory. Defaults to the "$laptop_local_repository_directory/src" variable.
configure_zsh() {
    local laptop_src_location=${1:-"$laptop_local_repository_directory/src"}

    log_header "🔧" "Configuring ZSH"

    # Create a local ZSH configuration file.
    copy_file "$laptop_src_location/.zshrc" "$laptop_config_directory/.zshrc"
    link_file "$laptop_config_directory/.zshrc" "$ZDOTDIR/.zshrc"

    # Create custom local ZSH configuration files.
    copy_file "$laptop_src_location/.zshrc_aliases" "$laptop_config_directory/.zshrc_aliases"
    copy_file "$laptop_src_location/.zshrc_methods" "$laptop_config_directory/.zshrc_methods"

    # Create a Atuin configuration file.
    copy_file "$laptop_src_location/atuin_config.toml" "$laptop_config_directory/atuin_config.toml"
    link_file "$laptop_config_directory/atuin_config.toml" "$HOME/.config/atuin/config.toml"
}

# Copy a file from the source path to the destination path if the file 
# does not already exist. When "overwrite" is true, the file will be replaced.
# Parameters:
#   source_path: The path to the source file to copy or URL of the file to download.
#   destination_path: The destination path where the file will be copied or downloaded.
#   overwrite: A boolean indicating whether to replace the destination file; defaults to false.
copy_file() {
    local source_path=$1
    local destination_path=$2
    local overwrite=${3:-false}

    local destination_directory="$(dirname "${destination_path}")"
    mkdir -p "$destination_directory"

    if [[ $overwrite == true || ! -f "$destination_path" ]]; then
        if [[ "$source_path" == http* ]]; then
            log "Downloading file from \"$source_path\" to \"$destination_path\""
            curl -o "$destination_path" "$source_path"
        else
            log "Copying file from \"$source_path\" to \"$destination_path\""
            cp "$source_path" "$destination_path"
        fi
    else
        log "No changes to file at \"$destination_path\"."
    fi
}

# Get secrets from 1Password and store them in global variables. This is a separate method
# so secrets can be gathered at the start of the script to prevent user interactions in the 
# middle of a lengthy script.
get_secrets() {
    log_header "🔐" "Gathering Secrets"

    # Make sure 1Password has an account configured and app integration enabled.
    if [[ $(op account list --format=json 2>/dev/null) == "[]" ]]; then
        log_error "There are no accounts configured for use with 1Password CLI. You must"\
                "enable app integration and then rerun this script.\n\n\t "\
                "Guide: https://developer.1password.com/docs/cli/app-integration/"
        exit 1
    fi

    log_attention "Requesting Unlock of 1Password to access the following information:" \
        "\n\n1. Item: \"$laptop_secret_item_name_git\"" \
        "\n   * Field: \"$laptop_secret_field_name_git_email\"" \
        "\n   * Field: \"$laptop_secret_field_name_git_username\"" \
        "\n   * Field: \"$laptop_secret_field_name_git_name\"" \
        "\n\n2. Item: \"$laptop_secret_item_name_ssh_key\"" \
        "\n   * Field: \"$laptop_secret_field_name_ssh_key_public\""

    $(op signin)

    log "Retrieving fields \"$laptop_secret_field_name_git_email\", \"$laptop_secret_field_name_git_name\", and" \
        "\"$laptop_secret_field_name_git_username\" from 1Password item \"$laptop_secret_item_name_git\"."

    git_email=$(op item get "$laptop_secret_item_name_git" --fields "$laptop_secret_field_name_git_email")
    git_name=$(op item get "$laptop_secret_item_name_git" --fields "$laptop_secret_field_name_git_name")
    git_username=$(op item get "$laptop_secret_item_name_git" --fields "$laptop_secret_field_name_git_username")
    if [[ -z "$git_email" || -z "$git_name" || -z "$git_username" ]]; then
        log_error "Failed to lookup secret fields \"$laptop_secret_field_name_git_email\", \"$laptop_secret_field_name_git_name\", and \"$laptop_secret_field_name_git_username\"" \
                        "from item \"$laptop_secret_item_name_git\" in 1Password. Make sure they exist."
        exit 1
    fi

    log "Retrieving field \"$laptop_secret_field_name_ssh_key_public\" from 1Password item \"$laptop_secret_item_name_ssh_key\"."
    
    git_ssh_public_key=$(op item get "$laptop_secret_item_name_ssh_key" --fields "$laptop_secret_field_name_ssh_key_public")

    if [[ -z "$git_ssh_public_key" ]]; then
        log_error "Failed to lookup secret field \"$laptop_secret_field_name_ssh_key_public\" from item" \
                        "\"$laptop_secret_item_name_ssh_key\" in 1Password. Make sure it exists."
        exit 1
    fi
}

# Install Xcode Command Line Tools, like git
install_apple_developer_tools() {
    if ! xcode-select -p &> /dev/null; then
        log_header "🍏" "Installing Apple's Developer Tools"
        xcode-select --install

        log_header "🍏" "Accepting the Apple Xcode License"
        sudo xcodebuild -license accept
    fi
}

# Install applications using Homebrew
install_apps() {
    log_header "🔧" "Installing Homebrew Applications"

    brew bundle --file=- <<EOF
    brew 'atuin' # https://atuin.sh
    brew 'awscli' # https://docs.aws.amazon.com/cli/
    brew 'curl' # https://curl.se
    brew 'coreutils' # https://formulae.brew.sh/formula/coreutils
    brew 'gawk' # https://www.gnu.org/software/gawk/
    brew 'gh' # https://cli.github.com
    brew 'gmp' # https://gmplib.org/
    brew 'gnupg' # https://www.gnupg.org
    brew 'libyaml' # https://pyyaml.org/wiki/LibYAML
    brew 'mise' # https://mise.jdx.dev
    brew 'openssl@3' # https://www.openssl.org/
    brew 'postgresql' # https://www.postgresql.org
    brew 'rustup-init' # https://rustup.rs
EOF

    # Initialize rustup with the default stable Rust toolchain non-interactively, if
    # it's not already installed and configured.
    if ! command -v rustup >/dev/null 2>&1; then
        rustup-init -y
    fi

    log_header "🔧" "Installing Applications"

    install_homebrew_cask "1password-cli"
    # install_homebrew_cask "netbirdio/tap/netbird-ui"
    install_homebrew_cask "visual-studio-code"

    install_claude_code
    install_mise_tools
    install_or_update_nvm
}

# Install Claude Code using the official install script, if it is not already
# installed. Note that using Homebrew to install would prevent automatic updates.
install_claude_code() {
    if ! command -v claude >/dev/null 2>&1; then
        log_header "🔧" "Installing Claude Code"
        curl -fsSL https://claude.ai/install.sh | bash
    else
        log "claude is already installed"
    fi
}

# Install a Homebrew Cask application if it is not already installed.
# Parameters:
#   cask_name: The name of the Homebrew Cask application to install.
install_homebrew_cask() {
    cask_name="$1"

    if ! brew list --cask $cask_name &>/dev/null; then
        log_header "🔧" "Installing $cask_name"
        brew install --cask $cask_name
    else
        log "$cask_name is already installed"
    fi
}

# Install and configure the user's PATH to include Homebrew. Or update 
# Homebrew if it's already installed.
install_or_update_homebrew() {
    if [[ $(command -v brew) == "" ]]; then
        log_header "🍺" "Installing Homebrew"
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

        # Add Homebrew to the user's PATH, if it's not already there.
        if [[ ":$PATH:" != *":$HOMEBREW_PREFIX/bin:"* ]]; then
            export PATH=$HOMEBREW_PREFIX/bin:$PATH
        fi
    else
        log_header "🍺" "Updating Homebrew"
        brew update --force # https://github.com/Homebrew/brew/issues/1151
    fi
}

# Installs NVM using the official install script from the NVM repository.
# If NVM is already installed, it will update NVM to the latest version.
# Verifies that NVM is installed and working by checking the version.
install_or_update_nvm() {
    log_header "🔧" "Installing or updating Node Version Manager (NVM)"

    # The PROFILE=/dev/null will prevent the setup script from updating
    # the bash profile(s), as this is already configured by the Laptop script.
    PROFILE=/dev/null bash -c 'curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/master/install.sh | bash'

    # Load nvm for the current shell, if it is not already loaded.
    local nvm_dir="${NVM_DIR:-${XDG_CONFIG_HOME:-$HOME/.nvm}}"
    export NVM_DIR="$nvm_dir"
    if [ -s "$NVM_DIR/nvm.sh" ]; then
        . "$NVM_DIR/nvm.sh"
    fi

    # Verify that nvm is installed and working.
    if command -v nvm >/dev/null 2>&1; then
        log "Node Version Manager (NVM) version $(nvm --version) is installed."
    else
        log_error "Node Version Manager (NVM) installation failed."
    fi
}

# Configures the mise global tools using the defined configuration file, then installs those tools.
install_mise_tools() {
    # Create the default global Mise configuration file, if it doesn't already exist
    configure_mise

    log_header "🔧" "Installing Mise Tools"

    # Add Cargo to the PATH, if it's not already there.
    if ! echo "$PATH" | grep -q "$HOME/.cargo/bin"; then
        export PATH="$HOME/.cargo/bin:$PATH"
    fi

    # Install all tools defined in Mise default global configuration
    (cd "$HOME" && mise install --yes)
}

