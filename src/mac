# Display an attention message to the user.
# Parameters:
#   $*: The attention message to display to the user.
log_attention() {
    local prefix=" 🟠 [$(date '+%T')] ATTENTION: "
    
    # Indent so that text wraps into a nice paragraph after the prefix.
    local indent="${(l:$((${#prefix}+1)):: :)}"  
    
    # Replaces escape sequences like a new line "\n" with the indentation for wrapping text.
    print "$*" | sed "1s/^/$prefix/;2,\$s/^/$indent/"
    print ""
}

# Prompt the user with a custom message. Returns zero if the user confirms 
# with "Y" or an empty string, (ie. presses enter), otherwise returns one.
# Parameters:
#   $*: The prompt message to display to the user.
log_prompt() {
    read "response? 🤨 $* "
    print -- ""

    if [[ -z $response || $response =~ ^[Yy] ]]; then
        # User confirmed with an empty response (ie. pressed enter) or the letter "Y".
        return 0
    else
        # User declined by entering any value (length > zero) that is not "Y".
        return 1
    fi
}

# Prompt the user to continue.
# Returns zero if the user confirms with "Y" or an empty string, 
# (ie. presses enter), otherwise returns one.
log_prompt_continue() {
    log_prompt "Ready to continue? [Y/n]"
}

# Display a terminal command to the user.
# Parameters:
#   $*: The terminal command to display.
log_command() {
    print -- "\n 🖥️   TERMINAL COMMAND: "$*""
