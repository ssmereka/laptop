    HOMEBREW_PREFIX="/opt/homebrew"
elif [ "$processor_architecture" = "x86_64" ]; then
    HOMEBREW_PREFIX="/usr/local"
else
    log_error "Unsupported processor architecture: $processor_architecture"
    exit 1
fi


